DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USERNAME=
DB_PASSWORD=

REDIS_HOST=localhost
REDIS_PORT=6379

MAIL_USERNAME=
MAIL_PASSWORD=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

JWT_SECRET=
OAUTH2_REDIRECT_URL=

AWS_CLOUDFRONT_DOMAIN=

# 비워두면 챗봇 @자유질의가 키워드 기반 응답으로 동작한다
FACTCHAT_API_KEY=
FACTCHAT_BASE_URL=https://factchat-cloud.mindlogic.ai/v1/gateway
FACTCHAT_MODEL=gemini-2.5-flash

# 비워두면 POST /api/test/teams(QA용 팀 즉시 생성)가 항상 403을 반환한다 - fail-safe
TEST_API_KEY=

# Firebase 서비스 계정 JSON을 base64로 인코딩한 값. 비워두면 FirebaseFcmClient.isEnabled()가 false를
# 반환해 FCM 발송을 조용히 건너뛴다 (docs/decisions/13-fcm-push.md)
# 인코딩: base64 -i service-account.json | tr -d '\n'
FIREBASE_CREDENTIALS_BASE64=